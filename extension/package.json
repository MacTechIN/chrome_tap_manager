{
  "name": "chrome-tap-manager-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Chrome_Project_manager - Chrome Extension (one window = one topic)",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@wxt-dev/module-solid": "1.1.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.3.4"
}
