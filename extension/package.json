{
  "name": "chrome-tap-manager-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome_Project_manager - Chrome Extension (one window = one topic)",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "node scripts/zip-store.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postinstall": "wxt prepare",
    "static": "wxt build && node scripts/sync-static.mjs"
  },
  "dependencies": {
    "es-hangul": "2.4.0",
    "minisearch": "7.2.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/node": "24.13.4",
    "@wxt-dev/module-solid": "1.1.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.3.4"
}
